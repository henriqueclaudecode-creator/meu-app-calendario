# Copie para .env.local e preencha. NÃO comite o .env.local.
#
# URL da Cloud Function de feriados (aparece após o deploy). É pública — só
# aponta para a function; a chave da API fica protegida no backend.
VITE_FERIADOS_FN_URL=https://southamerica-east1-SEU-PROJETO.cloudfunctions.net/feriados

# Obs.: a busca de locais (Eventos) usa o OpenStreetMap direto no app (grátis,
# sem chave) e os convites são compartilhados pelo próprio celular (.ics) — nada
# disso precisa de configuração ou backend.

# --- Firebase (App Web). A apiKey do Firebase Web NÃO é segredo. ---
# Pegue os valores em: Firebase Console → ⚙️ Configurações → Seus apps → App Web.
# Copie para .env.local (ignorado pelo git) e preencha.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=SEU-PROJETO.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=SEU-PROJETO
VITE_FIREBASE_STORAGE_BUCKET=SEU-PROJETO.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- RevenueCat (assinatura Premium). Chave PÚBLICA do SDK Android. ---
# RevenueCat Dashboard → Project settings → API keys → Public app key (Google).
# Sem esta chave o app usa o modo local (sem cobrança) — útil no dev/web.
VITE_REVENUECAT_ANDROID_KEY=

# --- Segredo (NÃO fica aqui e NÃO vai para o frontend). ---
# A chave da Feriados API é definida no Firebase, não neste arquivo:
#   firebase functions:secrets:set FERIADOS_API_KEY
