{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "site",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/privacidade", "destination": "/politica-privacidade.html" },
      { "source": "/exclusao", "destination": "/exclusao-de-dados.html" }
    ]
  }
}
