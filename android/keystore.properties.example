# Copie para android/keystore.properties e preencha com os dados do SEU keystore.
# NUNCA versione o keystore.properties nem o arquivo .jks/.keystore.
#
# 1) Gere o keystore (uma única vez, guarde em local seguro e faça backup):
#    keytool -genkey -v -keystore orbit-release.jks -keyalg RSA -keysize 2048 \
#            -validity 10000 -alias orbit
#
# 2) storeFile é o caminho relativo à pasta android/ (ou absoluto).

storeFile=orbit-release.jks
storePassword=SENHA_DO_KEYSTORE
keyAlias=orbit
keyPassword=SENHA_DA_CHAVE
