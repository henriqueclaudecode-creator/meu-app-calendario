<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Contagem Regressiva" do Orbit. Até dois blocos lado a lado, como no
     mockup ("Prova em 45 dias" · "Aniversário mãe em 22 dias"). O número grande é
     o único elemento colorido de destaque. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="14dp">

    <!-- Estado vazio -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:visibility="gone"
        android:text="Marque um evento como favorito\npara ver a contagem aqui."
        android:textColor="@color/orbit_text_soft"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/box_cards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="2">

        <!-- Cartão 0 -->
        <LinearLayout
            android:id="@+id/box_card0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/widget_card_soft_bg"
            android:padding="12dp">

            <ImageView
                android:id="@+id/c0_icone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_icon_circle"
                android:padding="9dp"
                android:src="@drawable/ic_widget_cap"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/c0_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Prova em"
                android:textColor="@color/orbit_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/c0_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45"
                android:textColor="@color/orbit_accent"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/c0_unidade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="dias"
                android:textColor="@color/orbit_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/c0_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="18 de setembro de 2025"
                android:textColor="@color/orbit_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Espaço entre cartões -->
        <View
            android:layout_width="10dp"
            android:layout_height="match_parent" />

        <!-- Cartão 1 -->
        <LinearLayout
            android:id="@+id/box_card1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/widget_card_soft_bg"
            android:padding="12dp">

            <ImageView
                android:id="@+id/c1_icone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_icon_circle"
                android:padding="9dp"
                android:src="@drawable/ic_widget_cap"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/c1_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Aniversário mãe em"
                android:textColor="@color/orbit_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/c1_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22"
                android:textColor="@color/orbit_accent"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/c1_unidade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="dias"
                android:textColor="@color/orbit_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/c1_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="26 de agosto de 2025"
                android:textColor="@color/orbit_text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Rodapé Premium (mostrado só para não assinantes) -->
    <TextView
        android:id="@+id/tv_premium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="8dp"
        android:background="@drawable/widget_icon_circle"
        android:gravity="center"
        android:visibility="gone"
        android:text="🔒 Recurso Premium — assine o Orbi para desbloquear"
        android:textColor="@color/orbit_text_soft"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
