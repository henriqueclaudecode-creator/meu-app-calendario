<?xml version="1.0" encoding="utf-8"?>
<!-- Uma linha da "Agenda de Hoje": ponto + horário + tile do ícone + textos. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/ag_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:src="@drawable/widget_dot"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/ag_hora"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="09:00"
        android:textColor="@color/orbit_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/ag_icone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_tile_bg"
        android:padding="10dp"
        android:src="@drawable/ic_widget_event"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ag_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Academia"
            android:textColor="@color/orbit_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ag_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Smart Fit"
            android:textColor="@color/orbit_text_soft"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
