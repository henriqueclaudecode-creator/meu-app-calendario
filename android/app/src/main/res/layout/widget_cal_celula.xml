<?xml version="1.0" encoding="utf-8"?>
<!-- Uma célula (dia) da grade do calendário. Número + até 2 chips + "+N". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:minHeight="52dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:paddingLeft="2dp"
    android:paddingRight="2dp">

    <TextView
        android:id="@+id/cel_num"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/orbit_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cel_chip0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/widget_chip_bg"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:text=""
        android:textColor="@color/orbit_text"
        android:textSize="8sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/cel_chip1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/widget_chip_bg"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:text=""
        android:textColor="@color/orbit_text"
        android:textSize="8sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/cel_extra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:paddingLeft="3dp"
        android:text=""
        android:textColor="@color/orbit_text_muted"
        android:textSize="8sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
